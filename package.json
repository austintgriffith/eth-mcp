{
  "name": "eth-mcp",
  "version": "0.3.0",
  "description": "MCP server for AI-driven Ethereum development with Scaffold-ETH",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "eth-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "protocol-packs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "ethereum",
    "scaffold-eth",
    "web3",
    "ai",
    "model-context-protocol",
    "foundry",
    "solidity",
    "defi",
    "smart-contracts"
  ],
  "author": "Austin Griffith",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/austintgriffith/eth-mcp.git"
  },
  "homepage": "https://github.com/austintgriffith/eth-mcp#readme",
  "bugs": {
    "url": "https://github.com/austintgriffith/eth-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
